# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env est ignoré par git : ne JAMAIS committer de clé.

# --- Hémicycle : pipeline mensuel (API REST) ---
# Clé à créer sur https://hemicycle.ai/compte-api
# hmc_test_... : gratuite, 100 appels/jour | hmc_live_... : consomme des crédits
HEMICYCLE_API_KEY=hmc_test_xxxxxxxxxxxxxxxx
HEMICYCLE_API_BASE_URL=https://api.hemicycle.ai/v1
HEMICYCLE_API_VERSION=2026-10-01

# --- Hémicycle : chatbot (serveur MCP) ---
# Clé dédiée au chatbot, distincte de celle du pipeline (révocable séparément)
HEMICYCLE_MCP_URL=https://api.hemicycle.ai/mcp
HEMICYCLE_MCP_KEY=hmc_test_xxxxxxxxxxxxxxxx

# --- Featherless : LLM du chatbot ---
# Clé à récupérer dans le tableau de bord Featherless
FEATHERLESS_API_KEY=xxxxxxxxxxxxxxxx
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Arete 27B (Nous Research, base Qwen3.8) : 32K de contexte, 2 unités de concurrence, tool calling
FEATHERLESS_MODEL=NousResearch/Arete-27B

# --- Chatbot ---
CHATBOT_PORT=8000
CHATBOT_MAX_TOOL_CALLS=5

# --- Front-end ---
FRONTEND_PORT=5173
# URL du chatbot vue par le site
PUBLIC_CHATBOT_URL=http://localhost:8000
